# Local development environment. This file is git-ignored.
# It uses zero-dependency defaults (SQLite + local storage + no AI provider) so
# `npm run dev` works immediately. Replace values for production.

NODE_ENV=development
APP_NAME=NyayaAI
APP_URL=http://localhost:3010
ALLOWED_ORIGINS=http://localhost:3010

DATABASE_URL="file:./dev.db"

SESSION_SECRET=dev-only-insecure-session-secret-change-me-please-32chars
ENCRYPTION_KEY=ZGV2LW9ubHktaW5zZWN1cmUtZW5jcnlwdGlvbi1rZXk=

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage

AI_PROVIDER=none
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_CHAT_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
AI_REQUEST_TIMEOUT_MS=45000
AI_MAX_RETRIES=2
AI_RATE_LIMIT_PER_MINUTE=20
AI_ALLOW_DOCUMENT_TRANSMISSION=false

STT_PROVIDER=none
TTS_PROVIDER=none
OCR_PROVIDER=none
MALWARE_SCANNER=none

EMAIL_DRIVER=console
EMAIL_FROM="NyayaAI <no-reply@nyayaai.local>"

SMS_DRIVER=console
SMS_OTP_TTL_MINUTES=10
SMS_OTP_MAX_ATTEMPTS=5

MAX_UPLOAD_MB=25
MAX_PDF_PAGES=500

RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=120
