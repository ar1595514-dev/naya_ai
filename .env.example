# =============================================================================
# NyayaAI environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Only placeholder values belong in this file.
# =============================================================================

# --- Core -------------------------------------------------------------------
NODE_ENV=development
APP_NAME=NyayaAI
# Public base URL used to build links in emails and for CSRF origin checks.
APP_URL=http://localhost:3000
# Canonical hostnames allowed to send state-changing requests (CSV).
ALLOWED_ORIGINS=http://localhost:3000

# --- Database ---------------------------------------------------------------
# DEVELOPMENT (default in this repo): SQLite file, zero external services.
DATABASE_URL="file:./dev.db"
# PRODUCTION: use PostgreSQL. Then also change the Prisma datasource provider
# in `prisma/schema.prisma` from "sqlite" to "postgresql" (see README).
# DATABASE_URL="postgresql://nyayaai:CHANGE_ME@localhost:5432/nyayaai?schema=public"

# --- Secrets (generate with: openssl rand -base64 48) -----------------------
# Used to sign session cookies. MUST be a long random value in production.
SESSION_SECRET=dev-only-insecure-session-secret-change-me-please-32chars
# AES-256-GCM key material for encrypting sensitive at-rest values (TOTP seeds).
# Provide 32 bytes base64. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=ZGV2LW9ubHktaW5zZWN1cmUtZW5jcnlwdGlvbi1rZXk=

# --- Object storage ---------------------------------------------------------
# "local" stores files under STORAGE_LOCAL_DIR (never inside /public).
# "s3" uses an S3-compatible private bucket (configure the values below).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- Redis / queues ---------------------------------------------------------
# Optional. When unset, NyayaAI uses a database-backed job queue (dev fallback).
REDIS_URL=

# --- AI provider ------------------------------------------------------------
# Provider is optional in development. With no provider the assistant returns a
# clearly-labelled "AI not configured" response and never fabricates answers.
# Supported kinds: openai-compatible | none
AI_PROVIDER=none
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_CHAT_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
AI_REQUEST_TIMEOUT_MS=45000
AI_MAX_RETRIES=2
# Per-user request budget (requests per minute) for AI endpoints.
AI_RATE_LIMIT_PER_MINUTE=20
# When true, confidential documents may be sent to the external AI provider,
# but only after the user gives explicit per-request consent.
AI_ALLOW_DOCUMENT_TRANSMISSION=false

# --- Speech providers (voice input / TTS) -----------------------------------
# Supported kinds: none | openai-compatible
STT_PROVIDER=none
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-1
TTS_PROVIDER=none
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=tts-1

# --- OCR ---------------------------------------------------------------------
# Supported kinds: none | tesseract | http
OCR_PROVIDER=none
OCR_HTTP_URL=
OCR_HTTP_API_KEY=

# --- Malware scanning --------------------------------------------------------
# Supported kinds: none | clamav-http
MALWARE_SCANNER=none
MALWARE_SCANNER_URL=

# --- Email -------------------------------------------------------------------
# Supported kinds: console (dev) | smtp
EMAIL_DRIVER=console
EMAIL_FROM="NyayaAI <no-reply@nyayaai.local>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# --- SMS / phone OTP ---------------------------------------------------------
# Supported kinds: none (refuses) | console (dev, logs code) | twilio (real SMS)
# With "console" the code is logged server-side and (outside production) also
# returned to the client as `devCode` so phone login works locally.
SMS_DRIVER=console
SMS_OTP_TTL_MINUTES=10
SMS_OTP_MAX_ATTEMPTS=5
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Uploads -----------------------------------------------------------------
MAX_UPLOAD_MB=25
MAX_PDF_PAGES=500

# --- Admin bootstrap ---------------------------------------------------------
# Optional: promotes a matching account to SUPER_ADMIN on first login. Keep
# empty in production unless you are performing a deliberate bootstrap.
BOOTSTRAP_ADMIN_EMAIL=

# --- Rate limits -------------------------------------------------------------
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=120
